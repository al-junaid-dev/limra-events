datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Recommended for Supabase connection pooling
}

generator client {
  provider = "prisma-client-js"
}

/// Defines the main categories required by the client
enum ServiceCategory {
  DECORATION
  LIGHTING
  TENT_HOUSE
  BUFFET
  ORCHESTRA
  OTHER
}

/// Tracks the lifecycle of a customer lead
enum InquiryStatus {
  PENDING
  CONTACTED
  BOOKED
  CANCELLED
}

/// The core services offered under Limra Events
model Service {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  category    ServiceCategory
  description String          @db.Text
  basePrice   Decimal?        @db.Decimal(10, 2)
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  vendors     Vendor[]        @relation("VendorServices")
  inquiries   CustomerInquiry[] @relation("InquiryServices")

  @@index([category])
}

/// Vendors managed or partnered with by Limra Events
model Vendor {
  id          String          @id @default(uuid())
  name        String
  contactName String
  email       String          @unique
  phone       String
  rating      Float           @default(5.0)
  isAvailable Boolean         @default(true)
  metadata    Json?           // For custom vendor attributes (e.g., menu types, instruments)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  services    Service[]       @relation("VendorServices")
}

/// Captures rich front-end lead data from potential clients
model CustomerInquiry {
  id             String          @id @default(uuid())
  customerName   String
  customerEmail  String
  customerPhone  String
  eventDate      DateTime
  estimatedGuest Int?
  message        String          @db.Text
  status         InquiryStatus   @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations (A user can select multiple services they are interested in)
  servicesRequested Service[]   @relation("InquiryServices")
  booking           Booking?
}

/// Stores finalized bookings linked to a validated inquiry
model Booking {
  id             String          @id @default(uuid())
  inquiryId      String          @unique
  inquiry        CustomerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  totalQuoted    Decimal         @db.Decimal(10, 2)
  advancePaid    Decimal         @default(0.00) @db.Decimal(10, 2)
  eventVenue     String          @db.Text
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}